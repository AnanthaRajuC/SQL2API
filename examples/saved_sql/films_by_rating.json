{
    "1": {
        "uuid": "00000000-0000-4000-8000-000000000001",
        "sql_query": "SELECT film_id, title, rating, length FROM film WHERE rating = :rating AND length <= :max_length ORDER BY title",
        "author": "sql2api",
        "description": "Films with a given rating up to a maximum length (minutes)",
        "tags": [
            "example"
        ],
        "query_parameters": {
            "rating": {
                "type": "str",
                "enum": [
                    "G",
                    "PG",
                    "PG-13",
                    "R",
                    "NC-17"
                ],
                "default": "PG",
                "description": "MPAA rating"
            },
            "max_length": {
                "type": "int",
                "min": 1,
                "max": 600,
                "default": 120,
                "description": "Longest film to include, in minutes"
            }
        },
        "connection_name": "sakila-sqlite",
